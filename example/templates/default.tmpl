<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.Title}} | {{.Meta.SiteTitle}}</title>
    {{if .Description}}<meta name="description" content="{{.Description}}">{{end}}
    <style>
        :root { --bg: #1a1a1a; --text: #e0e0e0; --dim: #a0a0a0; --accent: #d4a373; }
        body { 
            background: var(--bg); color: var(--text); 
            font-family: 'Georgia', serif; line-height: 1.7;
            max-width: 700px; margin: 0 auto; padding: 2rem 1rem;
        }
        h1 { font-family: system-ui, sans-serif; margin-bottom: 0.5rem; color: #fff; }
        .meta { color: var(--dim); font-size: 0.9rem; margin-bottom: 3rem; }
        .tags { margin-top: 0.75rem; margin-bottom: 0.5rem; }
        .tag {
          display: inline-block;
          color: var(--accent);
          font-family: system-ui, sans-serif;
          font-size: 0.8rem;
          margin-right: 0.5rem;
        }
        nav { margin-bottom: 2rem; }
        nav a { font-family: system-ui, sans-serif; font-size: 0.9rem; }
        
        article img { max-width: 100%; border-radius: 8px; }
        article blockquote { border-left: 3px solid var(--accent); padding-left: 1rem; font-style: italic; color: var(--dim); }
        article pre { background: #2a2a2a; padding: 1rem; overflow-x: auto; border-radius: 4px; }
    </style>
</head>
<body>
    <nav>
        <a href="/">← Back Home</a>
    </nav>

    <main>
        <header>
            {{if .Title}}<h1>{{.Title}}</h1>{{end}}
            <div class="meta">
                {{if .Date}}<time>{{.Date}}</time>{{end}}
                {{if .Author}} — {{.Author}}{{end}}
            </div>
            {{ if .Meta.Tags }}
            <div class="tags">
              {{ range .Meta.Tags }}
              <span class="tag">#{{ . }}</span>
              {{ end }}
            </div>
            {{ end }}

        </header>
        <article>
            {{.Content}}
        </article>
    </main>
</body>
</html>
