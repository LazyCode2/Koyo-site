<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.SiteTitle}}</title>
    <style>
        :root {
            --bg: #1a1a1a;
            --text: #e0e0e0;
            --dim: #a0a0a0;
            --accent: #d4a373;
            --gap: 2rem;
        }
        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Georgia', serif;
            line-height: 1.6;
            max-width: 700px;
            margin: 0 auto;
            padding: 2rem 1rem;
        }
        h1, h2, h3 { font-family: system-ui, sans-serif; color: #fff; }
        a { color: var(--accent); text-decoration: none; transition: opacity 0.2s; }
        a:hover { opacity: 0.8; text-decoration: underline; }
        
        header { margin-bottom: var(--gap); border-bottom: 1px solid #333; padding-bottom: var(--gap); }
        .bio { font-style: italic; color: var(--dim); margin-top: 0.5rem; }
        
        .post-list { list-style: none; padding: 0; }
        .post-item { margin-bottom: 1.5rem; }
        .post-date { font-size: 0.9rem; color: var(--dim); font-family: monospace; }
        .post-desc { margin: 0.25rem 0 0; font-size: 0.95rem; color: var(--dim); }
    </style>
</head>
<body>
    <header>
        <h1>{{.SiteTitle}}</h1>
        {{if .SiteAuthor}}<div class="bio">By {{.SiteAuthor}} — {{.SiteAuthorBio}}</div>{{end}}
    </header>

    <main>
        <div class="intro">
            {{.Content}}
        </div>

        <section>
            <h2>Recent Writing</h2>
            <ul class="post-list">
                {{range .Posts}}
                <li class="post-item">
                    <div class="post-date">{{if .Date}}{{.Date}}{{end}}</div>
                    <a href="{{.URL}}" style="font-size: 1.2rem; font-weight: bold;">{{.Title}}</a>
                    {{if .Description}}<p class="post-desc">{{.Description}}</p>{{end}}
                </li>
                {{end}}
            </ul>
        </section>
    </main>
</body>
</html>
